function verify(value){let code=String(value||"").trim();if(code.includes("#verificar/"))code=decodeURIComponent(code.split("#verificar/").pop());$("verify-code").value=code;if(!loaded){notice("Espera a que se carguen los certificados.");return}const r=find(code);if(!r){$("verify-result").innerHTML=`<span class="badge invalid">NO VÁLIDA</span><h2>Código no registrado</h2><p class="sub">No se encontró una certificación con el código ${esc(code)}.</p>`;return}$("verify-result").innerHTML=`${badge(r)}<h2>Certificación ${stateText[state(r)]}</h2>${[["Alumno",r.student_name],["Operador certificador",r.operator_name||"No indicado"],["Curso",r.course_name],["Equipo",r.equipment||"No indicado"],["Emisor",r.issuer],["Emisión",fmt(r.issued_at)],["Vencimiento",fmt(r.expires_at)],["Código",r.certificate_code]].map(([k,v])=>`<div class="result-item"><span>${k}</span><strong>${esc(v)}</strong></div>`).join("")}<button id="open-verified" class="small-btn canva-button">Abrir vista móvil</button>`;$("open-verified").onclick=()=>renderPublic(r)}
function copy(text){const ta=document.createElement("textarea");ta.value=text;ta.style.position="fixed";ta.style.opacity="0";document.body.appendChild(ta);ta.select();const ok=document.execCommand("copy");ta.remove();notice(ok?"Enlace copiado.":"No se pudo copiar el enlace.",ok?"success":"error")}
function openQr(r){const box=document.createElement("div");qr(box,link(r),r.qr_color,360);const canvas=box.querySelector("canvas");if(!canvas)return;const win=window.open("","_blank");if(win){win.document.write('<title>QR de certificación</title><body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#f5f7fb"><img alt="Código QR individual; usa Guardar imagen del navegador" src="'+canvas.toDataURL("image/png")+'"></body>');win.document.close();notice("QR abierto en otra pestaña. Usa «Guardar imagen» para conservarlo.","info")}else notice("Permite las ventanas emergentes para abrir el QR.","error")}

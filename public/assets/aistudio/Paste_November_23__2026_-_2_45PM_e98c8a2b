            <img id="logo-option" class="canva-image" src="_assets/MAHbtLKs23Y/1" alt="Logo circular de Capacitamaq" loading="lazy"><label for="logo-upload">Logo circular</label><input id="logo-upload" type="file" accept="image/*" class="field canva-input">
           </div>
           <div>
            <img id="company-option" class="canva-image" src="_assets/MAHbtA4HuaM/1" alt="Imagen corporativa de Capacitamaq" loading="lazy"><label for="company-upload">Imagen de empresa</label><input id="company-upload" type="file" accept="image/*" class="field canva-input">
           </div>
           <div>
            <img id="operator-option" class="canva-image" src="_assets/MAHbtLKs23Y/1" alt="Imagen de ejemplo editable para el perfil del operador; sustituir por una foto individual" loading="lazy"><label for="operator-upload">Foto del operador</label><input id="operator-upload" type="file" accept="image/*" class="field canva-input"><span class="hint">Imagen de ejemplo: reemplázala con una foto real.</span>
           </div>
          </div>
         </div>
         <div class="card editor-panel canva-card">
          <h2 class="panel-title"><i data-lucide="palette"></i> Apariencia</h2>
          <div class="form-grid">
           <div class="form-group">
            <label for="theme-color">Cabecera amarilla / color principal</label><input id="theme-color" type="color" class="field canva-input" value="#f3c970">
           </div>
           <div class="form-group">
            <label for="background-color">Fondo de la página pública</label><input id="background-color" type="color" class="field canva-input" value="#ffffff">
           </div>
           <div class="form-group">
            <label for="card-color">Fondo de tarjetas</label><input id="card-color" type="color" class="field canva-input" value="#fafafa">
           </div>
           <div class="form-group">
            <label for="font-choice">Tipografía</label><select id="font-choice" class="field canva-dropdown"><option value="Manrope">Manrope</option><option value="DM Sans">DM Sans</option><option value="Arial">Arial</option><option value="Georgia">Georgia</option></select>
           </div>
           <div class="form-group full">
            <label for="template-select">Distribución</label><select id="template-select" class="field canva-dropdown"><option value="classic">Clásica · referencia móvil</option><option value="modern">Moderna</option><option value="minimal">Minimalista</option></select>
           </div>
          </div>
         </div>

          <div id="preview-phone"></div>
         </div>
         <p class="hint">Las fotos cargadas desde tu dispositivo se conservan solo durante esta sesión; los datos del certificado sí se guardan.</p>
        </aside>
       </div>
      </form>
     </section>
     <section id="analytics" class="view canva-section" aria-labelledby="analytics-title">

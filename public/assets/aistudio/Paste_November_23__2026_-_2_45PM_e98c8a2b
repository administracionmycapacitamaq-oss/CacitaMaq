       <div>
        <p class="eyebrow">Credencial individual</p>
        <h1 id="detail-title">Detalle del certificado</h1>
        <p class="sub">Consulta, edita y comparte esta certificación.</p>
       </div>
       <button class="secondary canva-button" data-view="dashboard"><i data-lucide="arrow-left"></i> Volver al listado</button>
      </div>
      <div class="detail-layout">
       <article class="certificate canva-card">
        <img id="detail-logo" class="seal canva-image" src="_assets/MAHbtLKs23Y/1" alt="Logo circular de Capacitamaq" loading="lazy">

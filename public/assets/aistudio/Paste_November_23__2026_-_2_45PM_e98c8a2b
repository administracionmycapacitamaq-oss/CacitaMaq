           <label for="initial-status">Estado</label><select id="initial-status" class="field canva-dropdown"><option value="active">Publicar como certificado</option><option value="pending">Guardar como pendiente</option><option value="invalid">Marcar como no válido</option></select>
          </div>
          <div class="editor-actions">
           <button type="button" class="secondary canva-button" data-view="dashboard">Cancelar</button><button id="create-button" type="submit" class="primary canva-button"><i data-lucide="check"></i> Guardar certificación</button>
          </div>

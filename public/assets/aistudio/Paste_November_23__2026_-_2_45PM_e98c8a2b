           <div class="form-group">
            <label for="equipment">Equipo o maquinaria</label><input id="equipment" class="field canva-input" maxlength="100" value="Cargador frontal CAT992-K">
           </div>
           <div class="form-group full">
            <label for="issuer">Entidad certificadora *</label><input id="issuer" class="field canva-input" required maxlength="100" value="CAPACITAMAQ">
           </div>
           <div class="form-group">
            <label for="issue-date">Fecha de emisión *</label><input id="issue-date" type="date" class="field canva-input" required>
           </div>
           <div class="form-group">
            <label for="expiry-date">Fecha de vencimiento</label><input id="expiry-date" type="date" class="field canva-input">
           </div>
           <div class="form-group full">
            <label for="certificate-code">Identificador público editable</label><input id="certificate-code" class="field canva-input" maxlength="100" placeholder="Se generará automáticamente si queda vacío"><span class="hint">Cambiar el identificador modifica el enlace y el QR. Los enlaces anteriores dejarán de encontrar este certificado.</span>
           </div>
           <div class="form-group">
            <label for="issuer-url">Enlace de la empresa</label><input id="issuer-url" type="url" class="field canva-input" value="https://kangaroo-4gcts4.my.canva.site/">
           </div>
           <div class="form-group">
            <label for="whatsapp">WhatsApp de la empresa</label><input id="whatsapp" type="tel" class="field canva-input" value="+56983126221">
           </div>
           <div class="form-group">
            <label for="email">Correo de la empresa</label><input id="email" type="email" class="field canva-input" value="administracionmycapacitamaq@gmail.com">
           </div>
          </div>
         </div>
         <div class="card editor-panel canva-card">

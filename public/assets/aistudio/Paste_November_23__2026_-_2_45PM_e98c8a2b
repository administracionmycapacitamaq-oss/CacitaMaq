        <h2>Certificado de reconocimiento</h2>
        <div class="cert-line"></div>
        <div class="cert-foot">Se certifica que</div>
        <div id="detail-name" class="cert-name"></div>
        <div class="cert-foot">ha completado satisfactoriamente</div>
        <div id="detail-course" class="cert-course"></div>
        <div class="cert-line"></div>
        <div id="detail-meta" class="cert-foot"></div>
       </article>
       <aside class="card detail-side canva-card">

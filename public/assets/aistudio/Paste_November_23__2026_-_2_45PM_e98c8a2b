        <p class="sub">Escanea para abrir la verificación pública</p>
        <div id="qr-box" class="qr-box" aria-label="Código QR individual"></div>
        <div id="detail-code" class="code"></div>
        <div id="detail-status"></div>
        <a id="detail-public-link" class="detail-link canva-link" href="#" target="_blank" rel="noopener noreferrer"></a>
        <div class="stack-actions">
         <button id="public-this" class="primary canva-button">Vista previa móvil</button><button id="edit-this" class="secondary canva-button">Editar certificación</button><button id="copy-this" class="secondary canva-button">Copiar enlace</button><button id="download-this" class="secondary canva-button">Descargar QR</button><button id="share-this" class="secondary canva-button">Compartir</button><button id="toggle-this" class="secondary canva-button">Cambiar publicación</button>
        </div>

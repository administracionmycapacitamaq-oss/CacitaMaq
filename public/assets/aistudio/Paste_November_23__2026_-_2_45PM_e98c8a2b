           <div class="form-group">
            <label for="qr-pattern">Marco del QR</label><select id="qr-pattern" class="field canva-dropdown"><option value="square">Cuadrado</option><option value="soft">Bordes suaves</option><option value="frame">Marco de color</option></select>
           </div>

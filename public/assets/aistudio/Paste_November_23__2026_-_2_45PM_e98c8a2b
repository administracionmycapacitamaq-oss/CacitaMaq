            <label for="student-name">Nombre completo del alumno *</label><input id="student-name" class="field canva-input" required maxlength="100" placeholder="Nombre y apellidos">
           </div>
           <div class="form-group">
            <label for="certificate-type">Tipo de certificación *</label><select id="certificate-type" class="field canva-dropdown" required><option>Certificación de competencia</option><option>Constancia de formación</option><option>Diploma</option><option>Certificado de participación</option></select>

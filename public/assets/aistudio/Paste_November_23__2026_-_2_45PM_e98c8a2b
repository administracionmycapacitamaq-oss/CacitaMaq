           <div class="form-group full">
            <label for="course-name">Título de la certificación *</label><input id="course-name" class="field canva-input" required maxlength="120" value="CERTIFICACION DE CARGADOR FRONTAL CAT992-K">
           </div>
           <div class="form-group full">
            <label for="description">Texto de validación</label><textarea id="description" class="field canva-input" maxlength="400">CERTIFICACION VALIDADA POR UN AÑO CAPACITAMAQ</textarea>
